# Kim's Marbles server settings. Copy to .env (never commit .env).
# setup-vps.sh writes a real .env with generated secrets; this file documents every setting.
# The server checks these at startup and refuses to run with anything unsafe (config.js).

NODE_ENV=production
PORT=4100
APP_URL=https://vibenbones.online

# Postgres on the same VPS (setup-vps.sh creates the database and a random password).
# Never SeeWhy LIVE's Supabase project: the server refuses to start with it.
DATABASE_URL=postgres://kims:CHANGE_ME@127.0.0.1:5432/kims_marbles
PG_POOL_MAX=10

# openssl rand -hex 32
JWT_SECRET=

# Media (mediasoup). The VPS's PUBLIC IPv4. Worker i listens on MEDIASOUP_PORT + i (udp+tcp):
# with 2 workers open 44444-44445 udp AND tcp in the firewall.
MEDIASOUP_ANNOUNCED_IP=
MEDIASOUP_PORT=44444
MEDIASOUP_WORKERS=2

# TURN relay (coturn on this VPS). TURN_SECRET must equal static-auth-secret in /etc/turnserver.conf.
TURN_URLS=turn:turn.vibenbones.online:3478?transport=udp,turn:turn.vibenbones.online:3478?transport=tcp,turns:turn.vibenbones.online:5349?transport=tcp
TURN_SECRET=
TURN_TTL_SECONDS=3600
STUN_URLS=stun:turn.vibenbones.online:3478

# Stripe: TEST MODE ONLY (sk_test_...). A live key is refused unless STRIPE_ALLOW_LIVE=true,
# which must only be set after the legal review and Stripe's live activation.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# STRIPE_ALLOW_LIVE=false

# /metrics is off without a token. curl -H "Authorization: Bearer $METRICS_TOKEN" http://127.0.0.1:4100/metrics
METRICS_TOKEN=

# A live room whose host has been gone this long ends by itself (ms). Default 2 minutes.
HOST_GRACE_MS=120000

# Only if the app is served from a DIFFERENT domain than the API (not the case here).
# CORS_ORIGINS=https://vibenbones.online

# The hashtag the weekly challenge counts on the dashboard.
WEEKLY_CHALLENGE_TAG=#SwirlChallenge
